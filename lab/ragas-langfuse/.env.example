# Copia este archivo a .env (no se versiona). El primer bloque es el mismo de demo-langfuse/.env.

# --- Langfuse (el servidor que levanta demo-langfuse/levantar_langfuse.sh)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# --- El generador del RAG: el vLLM de la H200 (con la VPN GlobalProtect)
OPENAI_BASE_URL=http://172.28.230.10:12555/v1
OPENAI_API_KEY=
# Opcional: el id del generador. Vacío → se le pregunta al servidor.
MODELO=

# --- El juez y los embeddings: el Ollama de la H200 (otra familia que el generador)
JUEZ_BASE_URL=http://172.28.230.10:11434/v1
# Opcional: el modelo juez (por defecto gemma3:27b, el del Taller 4)
JUEZ=
