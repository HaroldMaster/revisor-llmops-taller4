# El AGENTE: las mismas tres rutas del Lab 03 (ver ../Lab-03-Agentes/.env.example).
# Con la H200 de la USFQ (GlobalProtect conectada), a costo cero:
OPENAI_BASE_URL=http://172.28.230.10:12555/v1
OPENAI_API_KEY=local
AGENT_MODEL=
#   el id que devuelve /v1/models; no se escribe de memoria:
#   python -c "import json,urllib.request;print(json.load(urllib.request.urlopen('http://172.28.230.10:12555/v1/models'))['data'][0]['id'])"

# El JUEZ: otro servidor y otra familia que el agente. Con la H200, el Ollama del 11434:
JUEZ_BASE_URL=http://172.28.230.10:11434/v1
JUEZ_API_KEY=ollama
JUEZ_MODEL=
#   el comienzo del id basta (gemma3 → gemma3:27b); lista lo servido con:
#   python -c "import json,urllib.request;print([m['id'] for m in json.load(urllib.request.urlopen('http://172.28.230.10:11434/v1/models'))['data']])"
# Con la clave del curso: borra OPENAI_BASE_URL y JUEZ_BASE_URL, pon OPENAI_API_KEY y
# JUEZ_API_KEY, y toma AGENT_MODEL y JUEZ_MODEL de sus filas de fuentes/modelos/modelos-2026-1.json.

# El PRECIO: local (H200, Ollama: cero por llamada) o el id de una fila de la tabla semestral
PRECIO_FILA=local

# LANGFUSE (obligatorio en la Parte 1 desde el 2026-10-06). Las claves del proyecto salen de
# Settings → API Keys, o de ../../actividades/semana-4/demo-langfuse/.env si lo levantaste
# con levantar_langfuse.sh. Este .env no se versiona.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
#   o https://cloud.langfuse.com con Langfuse Cloud

# Lo que lee el andamiaje tal como se repartió (evaluation.py, instrumented_agent.py).
# instrumented_agent.py llama a la API de la versión 3 de Langfuse: con USE_LANGFUSE=true
# falla en silencio, y es a propósito (sesión 17).
EVAL_JUDGE_MODEL=
USE_LANGFUSE=false
