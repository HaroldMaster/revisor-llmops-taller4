OPENAI_API_KEY=
AGENT_MODEL=
AGENT_DB_PATH=data/database.sqlite
AGENT_TRACE_DIR=traces
# Ruta sin costo: la H200 de la USFQ, con GlobalProtect conectada. El SDK de OpenAI lee
# OPENAI_BASE_URL del entorno, así que agent.py no cambia. Con esta ruta OPENAI_API_KEY
# puede ser cualquier texto no vacío, y AGENT_MODEL es el id que devuelve /v1/models:
#   python -c "import json,urllib.request;print(json.load(urllib.request.urlopen('http://172.28.230.10:12555/v1/models'))['data'][0]['id'])"
# OPENAI_BASE_URL=http://172.28.230.10:12555/v1
# Ruta local con Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 y AGENT_MODEL=<modelo descargado>
# ANTHROPIC_API_KEY=   # solo si usas langchain-anthropic en una extensión
