# Copiar a .env y completar. El archivo .env nunca se sube al repositorio.

# Proveedor del modelo: openai (H200, clave del curso, Ollama) o anthropic
LLM_PROVIDER=openai
LLM_BASE_URL=http://172.28.230.10:12555/v1
LLM_API_KEY=local
# Vacío: se lee del endpoint /v1/models (la H200 cambia de modelo sin aviso)
LLM_MODEL=
# Cupo de salida por respuesta. Medido con 2 048, 4 096 y 8 192: una respuesta normal usa
# menos de 1 000 tokens, y un cupo holgado solo alarga las respuestas vacías.
LLM_MAX_TOKENS=4096
LLM_MAX_TOKENS_SINTETIZADOR=4096
# Segundos máximos por llamada al modelo
LLM_TIMEOUT_S=60
# low | medium | high. Vacío: no se envía (proveedores que no lo admiten)
LLM_REASONING_EFFORT=low

# Embeddings del RAG: siempre aparte del modelo
EMBED_BASE_URL=http://172.28.230.10:11434/v1
EMBED_API_KEY=local
EMBED_MODEL=bge-m3:latest

# Solo si algún rol usa Anthropic (ver modelos.toml.example)
ANTHROPIC_API_KEY=

# --- Taller 4 ---
# El juez: otro servidor y otra familia que el agente. El comienzo del id basta (gemma3).
JUEZ_BASE_URL=http://172.28.230.10:11434/v1
JUEZ_API_KEY=ollama
JUEZ_MODEL=gemma3
# local (H200: cero por llamada) o el id de una fila de la tabla de precios del curso
PRECIO_FILA=local
# Langfuse: claves del proyecto (Settings → API Keys). Nunca al repositorio.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Sesión y etiqueta con que se agrupan los spans de una medición
LANGFUSE_SESION=harold-flores-base
LANGFUSE_ETIQUETA=taller-04
